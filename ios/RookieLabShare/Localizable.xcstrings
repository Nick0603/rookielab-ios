{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "Rookie Lab": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rookie Lab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rookie Lab"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rookie Lab"
          }
        }
      }
    },
    "在 Chess.com 或 Lichess 的對局頁按分享，再選 Rookie Lab。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a game page in Chess.com or Lichess, tap Share, then choose Rookie Lab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la página de una partida de Chess.com o Lichess, toca Compartir y elige Rookie Lab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na página de uma partida do Chess.com ou do Lichess, toque em Compartilhar e escolha o Rookie Lab."
          }
        }
      }
    },
    "在 Rookie Lab 打開": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Rookie Lab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir en Rookie Lab"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir no Rookie Lab"
          }
        }
      }
    },
    "已複製": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado"
          }
        }
      }
    },
    "打不開 App 的話：複製連結，到 Rookie Lab 的「對局」頁按右上角貼上。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app doesn't open: copy the link, then paste it with the button at the top right of the \"Games\" tab in Rookie Lab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la app no se abre: copia el enlace y pégalo con el botón de arriba a la derecha en la pestaña \"Partidas\" de Rookie Lab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o app não abrir: copie o link e cole com o botão no canto superior direito da aba \"Partidas\" do Rookie Lab."
          }
        }
      }
    },
    "收到對局了": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game received"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partida recibida"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Partida recebida"
          }
        }
      }
    },
    "複製連結": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar enlace"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar link"
          }
        }
      }
    },
    "這裡沒有對局連結": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No game link here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay enlace de partida"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui não há link de partida"
          }
        }
      }
    },
    "關閉": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar"
          }
        }
      }
    }
  },
  "version": "1.1"
}
