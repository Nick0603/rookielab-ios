    "今天的 5 題進度、連續天數，還有剛下完的那一局": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's progress on 5 puzzles, your streak, and the game you just finished"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu avance en los 5 problemas de hoy, tu racha y la partida que acabas de terminar"
