    "殘局子少，一步錯就收不回來：先算對手的反擊，再推兵": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With few pieces left, one slip can't be undone: check the opponent's counterplay first, then push the pawn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con pocas piezas, un desliz no se recupera: calcula primero el contrajuego del rival y luego avanza el peón"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com poucas peças, um deslize não se desfaz: veja primeiro o contra-ataque do adversário e depois avance o peão"
          }
        }
      }
    },
