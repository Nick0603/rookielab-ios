        }
      }
    },
    "由舊到新；綠點贏、紅點輸、灰點和。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldest to newest. Green dots are wins, red dots losses, gray dots draws."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De la más antigua a la más reciente. Punto verde: victoria; rojo: derrota; gris: tablas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da mais antiga para a mais recente. Ponto verde: vitória; vermelho: derrota; cinza: empate."
          }
        }
      }
    },
    "當時的問題：%@": {
