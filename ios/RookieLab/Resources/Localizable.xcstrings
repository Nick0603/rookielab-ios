    "%lld 個失誤裡，%lld%% 是很快就走的。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of your %lld mistakes, %lld%% were played quickly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De tus %lld errores, el %lld %% se jugó muy rápido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos seus %lld erros, %lld%% foram jogados rápido."
          }
        }
      }
    },
    "%lld 個失誤裡，%lld%% 是很快就走的：失誤多半是走太快，關鍵局面多想幾秒。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of your %lld mistakes, %lld%% were played quickly: most came from moving too fast, so take a few more seconds in critical positions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De tus %lld errores, el %lld %% se jugó muy rápido: la mayoría vino de ir demasiado deprisa; dedica unos segundos más en las posiciones críticas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos seus %lld erros, %lld%% foram jogados rápido: a maioria veio de jogar depressa demais; dedique alguns segundos a mais nas posições críticas."
          }
        }
      }
    },
