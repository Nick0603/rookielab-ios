    "車": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "rook"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "torre"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "torre"
          }
        }
      }
    },
    "車先切斷 d 線：對方的王不能往左邊跑": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rook cuts off the d-file: their king can't run to the left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La torre corta la columna d: el rey rival no puede huir hacia la izquierda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A torre corta a coluna d: o rei adversário não pode fugir para a esquerda"
          }
        }
      }
    },
    "車兵對車要贏：用車「搭橋」擋住將軍": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To win rook and pawn vs rook, \"build a bridge\" with the rook to block the checks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ganar torre y peón contra torre, \"construye el puente\" con la torre para frenar los jaques"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para vencer torre e peão contra torre, \"construa a ponte\" com a torre para bloquear os xeques"
          }
        }
      }
    },
    "車再切一條線：對方只剩 g、h 兩條線": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rook cuts another file: they only have the g- and h-files left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La torre corta otra columna: al rival solo le quedan las columnas g y h"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A torre corta outra coluna: só restam as colunas g e h"
          }
        }
      }
    },
    "車再往右切一條線：e 線也過不去了": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rook cuts one more file to the right: the e-file is closed too"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La torre corta una columna más a la derecha: la columna e también queda cerrada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A torre corta mais uma coluna à direita: a coluna e também fica fechada"
          }
        }
      }
    },
    "車守在第 6 排：對方的王不能上到第 6 排": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rook holds the 6th rank: their king can't step up to it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La torre domina la sexta fila: el rey rival no puede subir a ella"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A torre domina a sexta linha: o rei adversário não consegue subir até ela"
          }
        }
      }
    },
    "車將軍，把對方的王趕到 e 線（遠離兵）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rook gives check and drives their king to the e-file, away from the pawn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La torre da jaque y empuja al rey rival a la columna e, lejos del peón"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A torre dá xeque e leva o rei adversário para a coluna e, longe do peão"
          }
        }
      }
    },
    "車將軍，把王往上趕": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rook gives check and pushes the king up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La torre da jaque y empuja al rey hacia arriba"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A torre dá xeque e empurra o rei para cima"
          }
        }
      }
    },
    "車從後面一直將軍，對方的王沒地方躲，就是和棋": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep checking from behind. With nowhere to hide, their king can't make progress, and the game is drawn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue dando jaques desde atrás. Sin dónde esconderse, el rey rival no progresa y la partida es tablas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue dando xeques por trás. Sem onde se esconder, o rei adversário não progride e a partida é empate"
          }
        }
      }
    },
    "車把對方的王「切」在一邊：一條線一條線縮小它的空間": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rook \"cuts off\" their king on one side, shrinking its space file by file"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La torre \"corta\" al rey rival por un lado y reduce su espacio columna a columna"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A torre \"corta\" o rei adversário de um lado e reduz o espaço dele coluna por coluna"
          }
        }
      }
    },
    "車放在兵的後面、車要主動": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rook behind the pawn, and keep the rook active"
