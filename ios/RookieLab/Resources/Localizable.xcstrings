    "少一個兵要守和：車守在第 6 排，不讓對方的王上來": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a pawn down, play for the draw: keep the rook on the 6th rank so their king can't come forward"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un peón menos, busca las tablas: mantén la torre en la sexta fila para que el rey rival no avance"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um peão a menos, busque o empate: mantenha a torre na sexta linha para o rei adversário não avançar"
          }
        }
      }
    },
    "少一個兵要守和：車守第六排，兵上來就從後面將軍": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pawn down, hold the draw: keep the rook on the 6th rank, and when the pawn advances, check from behind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un peón menos, busca tablas: la torre en la sexta fila y, cuando el peón avance, jaques desde atrás"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um peão a menos, segure o empate: torre na sexta linha e, quando o peão avançar, xeques por trás"
          }
        }
      }
    },
